# Build output and generated files.
#
# Everything listed here is produced by building the project, so it exists in
# any clone after the first build and would otherwise show up as untracked.

# Staging directory used by build.ps1
/build_temp/

# Packaged mod artifacts
/releases/

# Animation data generated from a local game install by build_adb.py
/mod_assets/

*.pak
*.zip
*.log

__pycache__/

# Editor settings
.idea/
.vscode/
